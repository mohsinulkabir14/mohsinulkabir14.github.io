@article{raiyan2026ai4math,
  title     = {Artificial Intelligence for Mathematical Reasoning: An Integrated Survey of Language Models, Neuro-symbolic Systems, and Verified Discovery},
  author    = {Raiyan, Syed Rifat and Kabir, Mohsinul and Mahmud, Hasan and Hasan, Md Kamrul and Ananiadou, Sophia},
  journal   = {arXiv preprint arXiv:2606.08728},
  year      = {2026},
  month     = {jun},
  doi       = {10.48550/arXiv.2606.08728},
  abbr      = {arXiv},
  domain    = {reasoning},
  arxiv     = {2606.08728},
  pdf       = {https://arxiv.org/pdf/2606.08728},
  code      = {https://github.com/Starscream-11813/awesome-AI4Math},
  tldr      = {A 47-page survey of AI for mathematics, from math word problem solvers to reasoning models, theorem provers and verified discovery, with a critical look at benchmarks, saturation and failure modes.},
  abstract  = {Mathematical reasoning has long served as a stringent test of machine intelligence; over the past decade, it has moved from a niche problem within NLP to one of the most consequential AI frontiers. This survey provides a unified account of the field's evolution, from early rule-based math word problem (MWP) solvers and template-driven geometry systems, through neural expression generation and LLM prompting, to contemporary reasoning models, multi-agent systems, neuro-symbolic theorem provers, and verified discovery workflows. We organize the landscape along four axes: (i) informal reasoning over text and diagrams; (ii) formal reasoning in proof assistants, including autoformalization, tactic prediction, compiler-guided repair, and proof search; (iii) mathematical discovery; and (iv) the inference and training-time techniques, including CoT prompting, tool use, process reward models, and RLVR, that increasingly connect generation with verification. We catalog major benchmarks and examine benchmark saturation, contamination, and reporting mismatches. We critically assess failure modes: brittleness under perturbation, reward hacking, multimodal grounding failures, fragile formalization, and the energy cost of reasoning-scale inference, and identify future directions centered on verified-discovery workflows, reasoning efficiency, and infrastructure to make AI-assisted formalization broadly usable.},
  bibtex_show = {true}
}

@inproceedings{raiyan2023math,
  title     = {Math Word Problem Solving by Generating Linguistic Variants of Problem Statements},
  author    = {Raiyan, Syed Rifat and Faiyaz, Md. Nafis and Kabir, Shah Md. Jawad and Kabir, Mohsinul and Mahmud, Hasan and Hasan, Md Kamrul},
  booktitle = {Proceedings of the 61st Annual Meeting of the Association for Computational Linguistics (Volume 4: Student Research Workshop)},
  year      = {2023},
  month     = {jul},
  pages     = {362--378},
  publisher = {Association for Computational Linguistics},
  address   = {Toronto, Canada},
  doi       = {10.18653/v1/2023.acl-srw.49},
  url       = {https://aclanthology.org/2023.acl-srw.49/},
  abbr      = {ACL SRW},
  domain    = {reasoning},
  arxiv     = {2306.13899},
  html      = {https://aclanthology.org/2023.acl-srw.49/},
  pdf       = {https://aclanthology.org/2023.acl-srw.49.pdf},
  code      = {https://github.com/Starscream-11813/Variational-Mathematical-Reasoning},
  tldr      = {Makes math word problem solvers more robust by solving paraphrased variants of each problem and majority-voting the answers; also introduces the adversarial PARAMAWPS dataset.},
  abstract  = {The art of mathematical reasoning stands as a fundamental pillar of intellectual progress and is a central catalyst in cultivating human ingenuity. Researchers have recently published a plethora of works centered around the task of solving Math Word Problems (MWP), a crucial stride towards general AI. These existing models are susceptible to dependency on shallow heuristics and spurious correlations to derive the solution expressions. In order to ameliorate this issue, in this paper, we propose a framework for MWP solvers based on the generation of linguistic variants of the problem text. The approach involves solving each of the variant problems and electing the predicted expression with the majority of the votes. We use DeBERTa (Decoding-enhanced BERT with disentangled attention) as the encoder to leverage its rich textual representations and enhanced mask decoder to construct the solution expressions. Furthermore, we introduce a challenging dataset, ParaMAWPS, consisting of paraphrased, adversarial, and inverse variants of selectively sampled MWPs from the benchmark MAWPS dataset. We extensively experiment on this dataset along with other benchmark datasets using some baseline MWP solver models. We show that training on linguistic variants of problem statements and voting on candidate predictions improve the mathematical reasoning and robustness of the model.},
  bibtex_show = {true}
}


